# =====================================================================
# YEDN platform - environment variables
#
# LOCAL (Windows): copy this file to ".env" and edit it:   copy .env.example .env
# RENDER: do NOT upload .env. Set these in the Render dashboard (Environment tab);
#         render.yaml already fills in most of them for you.
# NEVER commit .env or any real password/key to GitHub.
# =====================================================================

# ---- Core ------------------------------------------------------------
# development on your PC, production on Render
APP_ENV=development
# Long random string. On Render it is generated automatically.
# To make one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Leave EMPTY locally to use SQLite (instance/app.db).
# On Render this is filled in automatically from the PostgreSQL database.
DATABASE_URL=
# Minutes of inactivity before users are logged out
SESSION_TIMEOUT_MINUTES=30
# true on Render (it sits behind a proxy); false on your PC
TRUST_PROXY=false

# ---- Uploaded files ----------------------------------------------------
# local    = save files in the uploads/ folder (your PC)
# database = save files inside the database (Render free plan: the disk is wiped on restart)
FILE_STORAGE=local
UPLOAD_FOLDER=
MAX_FILE_SIZE_MB=5

# ---- Public test deployment ---------------------------------------------
# Allow the built-in payment SIMULATOR when APP_ENV=production (no real money moves)
ALLOW_SANDBOX_PAYMENTS=false
# Load demo data at start-up via "flask --app app prepare-deploy" (never loads twice)
SEED_DEMO_DATA=false
# Password given to all demo accounts when demo data is loaded
DEMO_PASSWORD=
# Show the demo accounts and password on the login page (default: true locally, false in production)
SHOW_DEMO_LOGINS=
# Create your own Super Admin at start-up if it does not exist yet (Render has no shell on the free plan)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=YEDN Administrator

# ---- Payments ----------------------------------------------------------
# sandbox = built-in simulator; mpesa = real Safaricom Daraja (M-PESA Express / STK Push)
PAYMENT_PROVIDER=sandbox
# M-PESA Daraja consumer key and consumer secret
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
MPESA_ENV=sandbox
MPESA_SHORTCODE=
MPESA_PASSKEY=
# A long random string; it becomes part of the secret callback URL
MPESA_CALLBACK_TOKEN=
# Public https address of the site, e.g. https://yedn-platform.onrender.com
APP_BASE_URL=http://127.0.0.1:5000

# ---- SMS (Africa's Talking) -------------------------------------------
# console = only write messages to the log
SMS_PROVIDER=console
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=

# ---- Email (SMTP) ------------------------------------------------------
# Leave MAIL_SERVER empty to log emails instead of sending them
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=

# ---- Organization defaults (editable later in Admin > Settings) ---------
ORGANIZATION_NAME=Youth Enterprise & Development Network
ORGANIZATION_EMAIL=
ORGANIZATION_PHONE=
